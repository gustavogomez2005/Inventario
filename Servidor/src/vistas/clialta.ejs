<form action="/cliente/alta" method="post">
    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon1">Id</span>
    <input type="text" class="form-control" inputmode="numeric" id="idhtml" name="id" placeholder="Id del Cliente" aria-label="Username" aria-describedby="basic-addon1">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon2">Nombre</span>
    <input type="text" class="form-control" id="nomhtml"  name="nom" placeholder="Razón Social" aria-label="Recipient's username" aria-describedby="basic-addon2">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon3">Ciudad:</span>
    <input type="text" class="form-control" name="ciu" id="basic-url" aria-describedby="basic-addon3">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text">Calificación</span>
    <input type="text" class="form-control" data-only-numbers name="calif" aria-label="Amount (to the nearest dollar)">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text">Vendedor</span>
    <input type="text" class="form-control" data-only-numbers name="idvend" placeholder="Id del Vendedor" aria-label="Server">
    </div>
<button type="submit" class="btn btn-primary">Agregar</button>

</form>    

<script>
  const numeroid = document.getElementById('idhtml');
  numeroid.addEventListener('keydown', (e)=>{

    // Permitir teclas de control (Navegación y edición)
    const teclasPermitidas = ['ArrowLeft', 'ArrowRigth', 'Tab', 'Backspace', 'Delete', 'Enter'];
    
    // Si es una tecla permitida de navegación/edición, dejamos continuar
    if (teclasPermitidas.includes(e.key)) {
      return;
    }

    if (e.metaKey || e.ctrlKey) {
      return;
    }

    // Validar si el carácter presionado no es un dígito (0-9)
    if (!/^[0-9]$/.test(e.key)) {
      Swal.fire({
        icon: "error",
        title: "Error !!",
        text: "Debe ingresar solo números",
      });
      e.preventDefault(); // Bloquea la entrada de la tecla
    }
  })

  // Limpia cualquier carácter no numérico si el usuario pega contenido
  numeroid.addEventListener('input', (e)=>{
    this.value = this.value.replace(/[^0-9]/g, '');
    
  })



  const letra = document.getElementById('nomhtml');
  letra.addEventListener('beforeinput', (e)=>{
    // Si el evento inserta texto (como escribir o pegar)
    if (e.data) {
      // Expresión regular que permite letras (mayúsculas/minúsculas), acentos y espacios
      const caracterIngresado = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]$/;

      // Si la tecla presionado NO es una letra, cancelamos la entrada
      if (!caracterIngresado.test(e.data)) {
        Swal.fire({
          icon: "error",
          title: "Error !!",
          text: "Debe ingresar solo letras",
        });        
        e.preventDefault();
      }
    }
  })

  letra.addEventListener('paste', (e)=>{
    // 1. Obtener el texto que el usuario intenta pegar desde el portapapeles
    const textoPegado = (e.clipboardData || window.clipboardData).getData('text');

    // 2. Expresión regular que valida que TODO el texto sean letras, acentos o espacios
    const letras = /^[a-zA-ZáéíóúÁÉÍÓÚñÑ\s]+$/;

    // 3. Evaluar el texto completo
    if (!letras.test(textoPegado)) {
      Swal.fire({
        icon: "error",
        title: "Error !!",
        text: "El texto pegado solo debe tener letras y/o espacios",
      });      
      e.preventDefault(); // Cancela la acción de pegar si contiene números o símbolos
    }
  })

</script>




<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


