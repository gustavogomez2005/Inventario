    <h1>baja de clientes</h1>
<!-- <form action="/cliente/buscaxid/:id" method="post"> -->
<form onsubmit="tomaElValorPorParametro(event)"> 
    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon1">Id</span>
    <input type="text" class="form-control" id="id" name="id" placeholder="Id del Cliente" aria-label="Username" aria-describedby="basic-addon1">
    </div>

<button type="submit" class="btn btn-primary">BUSCAR</button>
<button type="reset" class="btn btn-danger">CANCELAR</button>

</form>        

<script>
  function tomaElValorPorParametro(event) {
    event.preventDefault();
    let id = document.getElementById('id').value;
     window.location.href = `/cliente/borrar/${id}`
    document.getElementById('id').value = '';
  }
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<% if (ok) { %>
  <% if (eliminado) { %>
    <script>
      Swal.fire({
        title: "Cliente Eliminado !!",
        icon: "success",
        draggable: true
      });
    </script>
  <% } else { %>
    <script>
      Swal.fire({
        icon: "error",
        title: "Error ...",
        text: "No pudo eliminar al Cliente!",
      });
    </script>    
  <% } %>
<% } %>

</body>
</html>