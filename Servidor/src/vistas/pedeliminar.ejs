    <h1>baja de clientes</h1>
<!-- <form action="/cliente/buscaxid/:id" method="post"> -->
<form onsubmit="tomaElValorPorParametro(event)"> 
    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon1">Id</span>
    <input type="text" disabled id="id" value=<%= codped %> name="id" class="form-control"  aria-label="Username" aria-describedby="basic-addon1">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon3">Precio:</span>
    <input type="text" name="precio" disabled  value=<%= precio %> class="form-control" id="basic-url" aria-describedby="basic-addon3">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text" id="basic-addon2">Fecha</span>
    <input type="date" name="fecha" disabled  value=<%= fecha %> class="form-control"  aria-label="Recipient's username" aria-describedby="basic-addon2">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text">Id del Cliente</span>
    <input type="text" name="idcli" disabled value=<%= codcli %>  class="form-control"  aria-label="Amount (to the nearest dollar)">
    </div>

    <div class="input-group mb-3">
    <span class="input-group-text">Vendedor</span>
    <input type="text" name="idvend" disabled value=<%= codvend %>  class="form-control" aria-label="Server">
    </div>

<button type="submit" class="btn btn-primary">ELIMINAR</button>
<button type="reset" class="btn btn-danger">CANCELAR</button>

</form>        

<script>
  function tomaElValorPorParametro(event) {
    event.preventDefault();
    let id = document.getElementById('id').value;
    window.location.href = `/pedido/eliminarxid/${id}`
    document.getElementById('id').value = '';
  }
</script>

</body>
</html>